# Normalize line endings across all platforms so the lab works identically
# whether cloned on Linux, Windows (WSL2/Git Bash), or macOS.
#
# Without this, a Windows clone with the default core.autocrlf=true rewrites
# text files to CRLF on checkout, which breaks:
#   - bash scripts  (\r in the shebang -> "bad interpreter: /usr/bin/env bash^M")
#   - PowerShell here-strings and Ansible-embedded PS
#   - Vagrantfile / YAML parsing edge cases
#
# Default: treat everything as text and check it out with LF everywhere.
* text=auto eol=lf

# Files that MUST stay LF regardless of platform (executed on Linux or in the
# Windows guest, never as native-Windows text).
*.sh        text eol=lf
*.ps1       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
Vagrantfile text eol=lf
Dockerfile  text eol=lf
.env        text eol=lf
.gitignore  text eol=lf

# Binary/opaque files git must never touch.
*.zip       binary
*.png       binary
*.jpg       binary
*.gz        binary
*.box       binary
