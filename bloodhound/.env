# BloodHound CE stack settings for the lab.
# Isolated lab only — these creds are intentionally simple. Change them if you
# ever expose this beyond the host.

# Web UI: reachable at http://127.0.0.1:8080 on the host.
BLOODHOUND_HOST=127.0.0.1
BLOODHOUND_PORT=8080

# Pin the app image for reproducibility (bump deliberately, not silently).
BLOODHOUND_TAG=latest

# Postgres (application DB)
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=labbloodhound
POSTGRES_DB=bloodhound

# Neo4j (graph DB)
NEO4J_USER=neo4j
NEO4J_SECRET=labbloodhound
